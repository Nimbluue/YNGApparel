{
  "name": "yng-apparel-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend REST API untuk YNG Apparel Custom Lab & Production Tracker",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --config ../eslint.config.js .",
    "test": "vitest run",
    "db:check": "tsx scripts/dbCheck.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "storage:init": "tsx scripts/initStorage.ts",
    "seed:admin": "tsx scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@yng/shared": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "file-type": "^19.6.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.16.0",
    "pg": "^8.14.1",
    "sharp": "^0.34.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.3",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.14",
    "tsx": "^4.19.4",
    "vitest": "^3.2.4"
  }
}
