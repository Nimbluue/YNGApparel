# ==============================================================================
# YNG APPAREL BACKEND — CONTOH KONFIGURASI ENVIRONMENT
# Salin file ini menjadi backend/.env lalu isi nilai sebenarnya.
# JANGAN PERNAH meng-commit file .env ke Git.
# ==============================================================================

# Server
NODE_ENV=development
PORT=5000
# Pisahkan dengan koma jika lebih dari satu origin, contoh: http://localhost:5173,https://yngapparel.id
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL (Supabase Session Pooler port 5432 untuk server long-running,
# atau Transaction Pooler port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# Autentikasi Admin (JWT di cookie httpOnly)
# Gunakan string acak minimal 32 karakter
JWT_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=12h
COOKIE_NAME=yng_admin_token
# Gunakan 'lax' jika satu domain induk (atau localhost via proxy), 'none' jika lintas domain HTTPS
COOKIE_SAMESITE=lax
# Otomatis true bila NODE_ENV=production atau COOKIE_SAMESITE=none
COOKIE_SECURE=false

# Object Storage (hanya diakses backend)
STORAGE_DRIVER=supabase
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=ganti_dengan_supabase_service_role_key

# Akun Admin Pertama (dipakai oleh: npm run seed:admin)
ADMIN_NAME=Owner YNG Apparel
ADMIN_EMAIL=admin@yngapparel.id
ADMIN_PASSWORD=ganti_password_admin_yang_kuat

# Notifikasi Telegram Admin (opsional — kosongkan jika tidak digunakan)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
